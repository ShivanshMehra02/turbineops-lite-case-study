// TurbineOps Lite — PostgreSQL schema (modular monolith)
// Table names remain Prisma defaults ("User", "Turbine", …) for migration continuity.
// For greenfield deploys, consider @@map("users") etc. and snake_case columns in a dedicated cutover migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Application login identity. RBAC via `role`; use `disabledAt` for soft-disable without deleting audit-related FKs (future).
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  role         Role
  passwordHash String
  disabledAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([role])
}

enum Role {
  ADMIN
  ENGINEER
  VIEWER
}

model Turbine {
  id             String        @id @default(cuid())
  name           String
  manufacturer   String?
  mwRating       Float?
  lat            Float?
  lng            Float?
  inspections    Inspection[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([name])
}

/// Inspection tied to a turbine. Overlap rule: **one inspection per turbine per UTC calendar day**, enforced via `inspectionDay` + DB unique index.
model Inspection {
  id              String       @id @default(cuid())
  /// Canonical instant for the inspection event (TIMESTAMP(3), convention: store UTC).
  date            DateTime
  /// UTC calendar date (`DATE`) derived from `date`; must stay in sync on writes — uniqueness prevents double-booking the same turbine/day.
  inspectionDay   DateTime     @db.Date
  inspectorName   String?
  dataSource      DataSource
  rawPackageUrl   String?
  turbine         Turbine      @relation(fields: [turbineId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  turbineId       String
  findings        Finding[]
  repairPlan      RepairPlan?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([turbineId, inspectionDay])
  @@index([turbineId, date])
  @@index([dataSource])
}

enum DataSource {
  DRONE
  MANUAL
}

model Finding {
  id             String           @id @default(cuid())
  category       FindingCategory
  /// Application rule layer should clamp; DB CHECK enforces bounds for defense in depth.
  severity       Int
  estimatedCost  Float
  notes          String?
  inspection     Inspection       @relation(fields: [inspectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  inspectionId   String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([inspectionId])
  @@index([category])
  @@index([severity])
  @@index([inspectionId, category])
}

enum FindingCategory {
  BLADE_DAMAGE
  LIGHTNING
  EROSION
  UNKNOWN
}

/// At most one repair plan per inspection (`inspectionId` unique). Removed when parent inspection is deleted.
model RepairPlan {
  id                 String       @id @default(cuid())
  inspection         Inspection   @relation(fields: [inspectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  inspectionId       String       @unique
  priority           Priority
  totalEstimatedCost Float
  snapshotJson       Json
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}
