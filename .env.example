# Backend
PORT=4000
JWT_SECRET=dev-secret-change
JWT_EXPIRES_IN=8h
# Optional JWT hardening (sets iss/aud claims; verification requires matching values)
# JWT_ISSUER=turbineops
# JWT_AUDIENCE=turbineops-api

# Prisma (Postgres)
DATABASE_URL=postgresql://app:app@localhost:5432/turbineops?schema=public

# Mongo
MONGO_URL=mongodb://localhost:27017
MONGO_DB=turbineops

# Frontend
VITE_API_BASE=http://localhost:4000
